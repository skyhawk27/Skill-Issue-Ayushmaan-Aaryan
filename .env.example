# PaperLens — environment variables
#
# Copy to `.env` at the repository root and fill in what you have:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit real keys.
# `paperlens/app.py` loads this file before any module reads its credentials.
# Variables already exported in your shell take precedence over this file.
#
# Every key below is OPTIONAL. Without any of them the dashboard still runs:
# upload, structured summary, verification badges, PDF navigation, evidence
# highlighting and export all work offline. Each key upgrades one feature.


# ── Citation metadata (Member 4) ──────────────────────────────────────────────
# Read by paperlens/citations/config.py at import time.
# OpenAlex is a free, open API and works WITHOUT a key — the key raises your rate
# limit. Without it you will see 429s and references fall back to locally parsed
# titles with no citation counts or abstracts.
OPENALEX_API_KEY=

# ── Summarization (Member 2) ─────────────────────────────────────────────────
# Read by paperlens/summarization/briefing.py, which builds its client at MODULE
# level — so without this the module cannot even be imported and the dashboard
# falls back to an extractive summary.
NVIDIA_API_KEY=

# ── Chat and embeddings (Member 3) ───────────────────────────────────────────
# Read by paperlens/rag/embeddings.py and paperlens/rag/chat.py.
# Without it the chat panel says so and offers offline keyword search.
OPENAI_API_KEY=

# Optional override, defaults to gpt-4.1 (paperlens/citations/config.py).
# OPENAI_MODEL=
