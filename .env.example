# PaperLens — environment variables
#
# Copy to `.env` at the repository root and fill in what you have:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit real keys.
# `paperlens/app.py` loads this file before any module reads its credentials.
# Variables already exported in your shell take precedence over this file.
#
# Every key below is OPTIONAL. Without any of them the dashboard still runs:
# upload, structured summary, verification badges, PDF navigation, evidence
# highlighting and export all work offline. Each key upgrades one feature.


# ── Citation metadata (Member 4) ──────────────────────────────────────────────
# Read by paperlens/citations/config.py at import time.
# OpenAlex is a free, open API and works WITHOUT a key — the key raises your rate
# limit. Without it you will see 429s and references fall back to locally parsed
# titles with no citation counts or abstracts.
OPENALEX_API_KEY=

# ── Summarization (Member 2) ─────────────────────────────────────────────────
# Read by paperlens/summarization/briefing.py, which builds its client at MODULE
# level — so without this the module cannot even be imported and the dashboard
# falls back to an extractive summary.
NVIDIA_API_KEY=

# ── Chat and embeddings (Member 3) ───────────────────────────────────────────
# Read by paperlens/rag/embeddings.py and paperlens/rag/chat.py, which default to
# OpenAI (gpt-4o + text-embedding-3-small). Both cost money.
OPENAI_API_KEY=

# Optional override, defaults to gpt-4.1 (paperlens/citations/config.py).
# OPENAI_MODEL=


# ── Free provider for chat + embeddings ──────────────────────────────────────
# Any OpenAI-compatible endpoint. Leave PAPERLENS_LLM_BASE_URL empty to keep the
# original OpenAI behaviour untouched. Setting it routes retrieval and chat
# through the provider instead — no changes to anyone's module, because both
# public functions already accept a `client=` argument.
#
# NVIDIA NIM (free tier, no card, same endpoint the summarizer already uses):
#   PAPERLENS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   PAPERLENS_LLM_API_KEY=$NVIDIA_API_KEY
#   PAPERLENS_CHAT_MODEL=meta/llama-3.1-8b-instruct
#   PAPERLENS_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
#
# Groq is chat-only — it has no embeddings endpoint, and build_index needs one,
# so Groq alone leaves the chat panel dead. Pair it with a provider that does.
PAPERLENS_LLM_BASE_URL=
PAPERLENS_LLM_API_KEY=
PAPERLENS_CHAT_MODEL=
PAPERLENS_EMBEDDING_MODEL=


# ── Rate limiting ────────────────────────────────────────────────────────────
# Requests per rolling minute, shared across the whole process. Default 28 sits
# under NVIDIA's 40/min. The summarizer alone fires 16 at once (one per page),
# so a single shared budget is what stops it starving the chat path.
# PAPERLENS_RATE_LIMIT_PER_MIN=28

# How many times to retry a 429/5xx with backoff. Default 6.
# PAPERLENS_MAX_RETRIES=6
