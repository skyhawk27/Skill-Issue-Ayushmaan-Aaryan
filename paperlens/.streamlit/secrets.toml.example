# PaperLens — secrets for a deployed app (Streamlit Community Cloud).
#
# This is the deployed counterpart to `.env.example`. `.env` is gitignored, so it
# does not exist on Cloud; paste the contents of this file into the app's
# Secrets pane (Manage app → Settings → Secrets) instead and fill in what you have.
#
# ─── The one rule that governs this file ─────────────────────────────────────
# Keep every key FLAT — top level, no `[tables]`. Streamlit copies top-level
# str/int/float secrets into `os.environ`, and that copy is the entire mechanism
# by which teammate modules see them: they read `os.getenv(...)` at import time
# and know nothing about `st.secrets`. Nest a key under a table and it stays
# invisible to them, silently, with no error — the feature just behaves as
# though no key were configured.
#
# `paperlens/app.py` touches `st.secrets` before those imports run, precisely so
# the promotion has already happened by then. See `_load_secrets()` there.
# ─────────────────────────────────────────────────────────────────────────────
#
# Every key is OPTIONAL. With none of them the app still runs: upload, structured
# summary, verification badges, PDF navigation, evidence highlighting and export
# all work offline. Each key upgrades one feature. Key-by-key notes live in
# `.env.example` at the repo root — the meanings are identical here.

# Citation metadata (Member 4). OpenAlex works without a key; this raises the
# rate limit and avoids 429s.
OPENALEX_API_KEY = ""

# Summarization (Member 2). Without it the dashboard falls back to an
# extractive summary.
NVIDIA_API_KEY = ""

# Chat and embeddings (Member 3). Defaults to OpenAI; costs money.
OPENAI_API_KEY = ""

# Route chat + embeddings through any OpenAI-compatible provider instead.
# Leave the base URL empty to keep the original OpenAI behaviour.
# For NVIDIA NIM's free tier, reuse the summarizer's endpoint:
#   PAPERLENS_LLM_BASE_URL = "https://integrate.api.nvidia.com/v1"
#   PAPERLENS_LLM_API_KEY = "<same value as NVIDIA_API_KEY>"
#   PAPERLENS_CHAT_MODEL = "meta/llama-3.1-8b-instruct"
#   PAPERLENS_EMBEDDING_MODEL = "nvidia/nv-embedqa-e5-v5"
PAPERLENS_LLM_BASE_URL = ""
PAPERLENS_LLM_API_KEY = ""
PAPERLENS_CHAT_MODEL = ""
PAPERLENS_EMBEDDING_MODEL = ""
